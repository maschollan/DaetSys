# URL dasar API backend untuk build PRODUCTION (Vite memuat file ini
# otomatis pada `npm run build`). Environment variable sungguhan yang
# diset di Render Dashboard menimpa nilai file ini jika keduanya ada.
#
# Sesuaikan dengan nama service Render yang sebenarnya.
VITE_API_BASE_URL=https://daetsys-api.onrender.com/api
