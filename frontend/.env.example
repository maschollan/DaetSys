# URL dasar API backend (tanpa trailing slash).
# Dev: "/api" (relatif) agar lewat proxy vite.config.js → Laravel lokal.
# Backend dan CORS-nya diset pada backend/.env (FRONTEND_URL).
VITE_API_BASE_URL=/api

# Varian animasi boot/reconnect (pilihan utama build production):
# terminal | radar | scan | orbit | equalizer
VITE_BOOT_ANIMATION=terminal
